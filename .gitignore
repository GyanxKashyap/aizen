data/tinystories_raw.txt
data/tinystories_raw2.txt
data/pretrain.txt
data/pretrain2.txt

# ---- Knowledge-graph working files (keep the three published outputs) ----
graphify-out/cache/
graphify-out/2*/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*

# ---- macOS ----
.DS_Store

# ---- Portfolio-OS spec: belongs to the gyan-os project, not Aizen ----
GYAN_OS_SPEC.md

# ---- Editor / dev-server config ----
.claude/

